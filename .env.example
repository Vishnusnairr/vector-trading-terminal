# ============================================================================
# Vector Algo Terminal — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ---- Database (SQLite for development) -------------------------------------
# For SQLite, this is just a file path. To switch to Postgres later, change
# the provider in prisma/schema.prisma and use a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# ---- NextAuth --------------------------------------------------------------
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# In production set this to your domain, e.g. https://vector.yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ---- OAuth Providers -------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- AI (optional, for the AI Assistant chunk) ------------------------------
# Leave blank to use the mock responder
OPENAI_API_KEY=""

# ---- Feature flags ---------------------------------------------------------
# Public so the client can read them
NEXT_PUBLIC_APP_NAME="Vector"
NEXT_PUBLIC_DEFAULT_PAPER_BALANCE="100000"
